# React Patterns

## Type Imports

Avoid using `React.` prefix for types. Import types directly from 'react'.

```typescript
// ❌ BAD
import { FC } from 'react';
const handleKeyDown = (event: React.KeyboardEvent<HTMLInputElement>): void => {};

// ✅ GOOD
import { FC, KeyboardEvent } from 'react';
const handleKeyDown = (event: KeyboardEvent<HTMLInputElement>): void => {};
```

## Inline Styles

Avoid inline styles in components. Create a separate styles file next to each component. This applies to all components, including UIkit components.

```typescript
// ❌ BAD
<div style={{ padding: 24, display: 'flex' }}>
<button style={{ padding: '8px 12px', borderRadius: 6 }}>

// ✅ GOOD
// ComponentName.styles.ts
import { CSSProperties } from 'react';

export const rootStyle: CSSProperties = {
  padding: 24,
  display: 'flex',
};

export const getButtonStyle = (variant: string): CSSProperties => ({
  padding: '8px 12px',
  borderRadius: 6,
});

// ComponentName.tsx
import { rootStyle } from './ComponentName.styles';
<div style={rootStyle}>
```

## UIkit Naming

Shared UI components are located in `@shared/UIkit/` (not `@shared/ui/`). All UIkit components must have their styles extracted to separate `.styles.ts` files.

## JSX Readability

After a closing tag (e.g. `</span>`, `</div>`), add a blank line before the next sibling element for better readability.

```tsx
// ❌ BAD
<span style={titleStyle}>
  {column.title}
</span>
<Button onClick={handleDelete}>

// ✅ GOOD
<span style={titleStyle}>
  {column.title}
</span>

<Button onClick={handleDelete}>
```

## Custom Hooks (non-provider)

Custom hooks that are not provider hooks (e.g. not `useBoardStoreProvider`) live at the **top level of the module** in a `hooks/` folder. Do not place them inside a specific component folder.

```
boardModule/
  hooks/
    useColumnDragAndDrop.ts
    columnReorder.helper.ts   # helper used only by the hook
  vm/
    BoardColumnVM/
  BoardModule.tsx
```

Import from the module hooks folder, e.g. `import { useColumnDragAndDrop } from '@pages/boardModule/hooks/useColumnDragAndDrop';`.

## Effects and Hooks

Keep `useEffect` bodies small and readable. Extract complex setup (e.g. drag-and-drop, subscriptions) into custom hooks. Extract pure logic (e.g. "compute new order from A, B, list") into helper modules.

```typescript
// ❌ BAD: huge effect with inline logic
useEffect(() => {
  return combine(
    draggable({ element, onDrop: () => { /* 20 lines */ } }),
    dropTargetForElements({ element, onDrop: () => { /* 30 lines */ } }),
  );
}, [deps]);

// ✅ GOOD: custom hook + pure helper
// columnReorder.helper.ts
export const getReorderedColumnIds = (sourceId, targetId, columnIds) => { ... };

// useColumnDragAndDrop.ts
export const useColumnDragAndDrop = (args) => {
  useEffect(() => {
    // wire up using helper
  }, [args.columnId, args.columnIds, args.onReorder]);
};

// Component
useColumnDragAndDrop({ elementRef, columnId, columnIds, onReorder, setIsDragging });
```

## Event Handlers

Always create named handler functions instead of inline arrow functions in JSX.

```typescript
// ❌ BAD
<Input
  onFocus={() => setIsFocused(true)}
  onBlur={() => setIsFocused(false)}
/>
<Button onClick={() => onDelete(id)} />

// ✅ GOOD
const handleFocus = (): void => {
  setIsFocused(true);
};

const handleBlur = (): void => {
  setIsFocused(false);
};

const handleDelete = (): void => {
  onDelete(id);
};

<Input
  onFocus={handleFocus}
  onBlur={handleBlur}
/>
<Button onClick={handleDelete} />
```
